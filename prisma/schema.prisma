generator client { provider = "prisma-client-js" }
datasource db { provider = "postgresql"; url = env("DATABASE_URL") }

enum UserRole { PLAYER CAPTAIN ADMIN }
enum MemberRole { PLAYER CAPTAIN }
enum PlayerRole { BATSMAN BOWLER ALL_ROUNDER WICKET_KEEPER }
enum BattingStyle { RIGHT_HANDED LEFT_HANDED }
enum BowlingStyle { RIGHT_ARM_FAST RIGHT_ARM_MEDIUM LEFT_ARM_FAST LEFT_ARM_MEDIUM OFF_SPIN LEG_SPIN LEFT_ARM_ORTHODOX OTHER }
enum SkillLevel { BEGINNER INTERMEDIATE ADVANCED }
enum BallType { TENNIS LEATHER }
enum PostStatus { OPEN MATCHED CANCELLED EXPIRED }
enum RequestStatus { PENDING ACCEPTED REJECTED WITHDRAWN }
enum MatchStatus { SCHEDULED LIVE COMPLETED CANCELLED ABANDONED }
enum TossDecision { BAT BOWL }
enum InningsStatus { NOT_STARTED LIVE COMPLETED }
enum ExtraType { WIDE NO_BALL BYE LEG_BYE PENALTY }
enum WicketType { BOWLED CAUGHT LBW RUN_OUT STUMPED HIT_WICKET RETIRED_HURT }
enum ConfirmationStatus { PENDING CONFIRMED DISPUTED }
enum NotificationType { MATCH_REQUEST REQUEST_ACCEPTED REQUEST_REJECTED MATCH_REMINDER RESULT_CONFIRMATION SYSTEM }
enum GroundSlotStatus { AVAILABLE HELD BOOKED BLOCKED }
enum GroundProposalStatus { PENDING ACCEPTED REJECTED EXPIRED }

model User {
  id String @id @default(cuid()); name String; email String @unique; passwordHash String; phone String?; role UserRole @default(PLAYER); createdAt DateTime @default(now()); updatedAt DateTime @updatedAt
  playerProfile PlayerProfile?; memberships TeamMember[]; captainedTeams Team[] @relation("Captain"); posts OpponentPost[]; requests MatchRequest[]; playingXIs PlayingXI[]; notifications Notification[]; resultConfirmations MatchResultConfirmation[]
}
model PlayerProfile {
  id String @id @default(cuid()); userId String @unique; user User @relation(fields:[userId], references:[id], onDelete:Cascade); displayName String; profileImage String?; city String @default("Hyderabad"); area String; battingStyle BattingStyle; bowlingStyle BowlingStyle; primaryRole PlayerRole; matchesPlayed Int @default(0); inningsPlayed Int @default(0); runs Int @default(0); ballsFaced Int @default(0); fours Int @default(0); sixes Int @default(0); highestScore Int @default(0); notOuts Int @default(0); wickets Int @default(0); ballsBowled Int @default(0); runsConceded Int @default(0); catches Int @default(0); stumpings Int @default(0); createdAt DateTime @default(now()); updatedAt DateTime @updatedAt
  ballsFacedRecords Ball[] @relation("Batsman"); nonStrikerBalls Ball[] @relation("NonStriker"); ballsBowledRecords Ball[] @relation("Bowler"); dismissals Ball[] @relation("DismissedPlayer"); battingScores BattingScore[]; bowlingScores BowlingScore[]
}
model Team {
  id String @id @default(cuid()); name String; slug String @unique; logo String?; city String @default("Hyderabad"); area String; description String?; captainId String; captain User @relation("Captain", fields:[captainId], references:[id]); skillLevel SkillLevel; preferredBallType BallType; matchesPlayed Int @default(0); wins Int @default(0); losses Int @default(0); ties Int @default(0); noResults Int @default(0); cancellations Int @default(0); noShows Int @default(0); rating Float @default(0); createdAt DateTime @default(now()); updatedAt DateTime @updatedAt
  members TeamMember[]; posts OpponentPost[]; requests MatchRequest[]; matches MatchTeam[]; playingXIs PlayingXI[]; innings Innings[]; ratingsReceived TeamRating[] @relation("RatedTeam"); ratingsGiven TeamRating[] @relation("RatingTeam"); tossWins Match[] @relation("TossWinner"); winsList Match[] @relation("Winner"); groundProposalsSent GroundProposal[] @relation("ProposingTeam"); groundProposalsReceived GroundProposal[] @relation("OpponentTeam")
}
model TeamMember { id String @id @default(cuid()); teamId String; userId String; memberRole MemberRole @default(PLAYER); jerseyNumber Int?; joinedAt DateTime @default(now()); team Team @relation(fields:[teamId], references:[id], onDelete:Cascade); user User @relation(fields:[userId], references:[id], onDelete:Cascade); @@unique([teamId,userId]) }
model Ground { id String @id @default(cuid()); name String; area String; city String @default("Hyderabad"); address String; latitude Decimal? @db.Decimal(9,6); longitude Decimal? @db.Decimal(9,6); pitchType String?; groundType String?; floodlights Boolean @default(false); verifiedAt DateTime?; createdAt DateTime @default(now()); updatedAt DateTime @updatedAt; posts OpponentPost[]; matches Match[]; slots GroundSlot[] }
model OpponentPost { id String @id @default(cuid()); teamId String; groundId String?; createdById String; matchDate DateTime; startTime String; endTime String; customGroundName String?; customGroundArea String?; overs Int; ballType BallType; skillLevel SkillLevel; totalGroundCost Decimal @db.Decimal(10,2); opponentShare Decimal @db.Decimal(10,2); notes String?; status PostStatus @default(OPEN); createdAt DateTime @default(now()); updatedAt DateTime @updatedAt; team Team @relation(fields:[teamId], references:[id]); ground Ground? @relation(fields:[groundId], references:[id]); createdBy User @relation(fields:[createdById], references:[id]); requests MatchRequest[]; match Match?; @@index([status,matchDate]) }
model MatchRequest { id String @id @default(cuid()); opponentPostId String; requestingTeamId String; requestedById String; message String?; status RequestStatus @default(PENDING); createdAt DateTime @default(now()); updatedAt DateTime @updatedAt; opponentPost OpponentPost @relation(fields:[opponentPostId], references:[id], onDelete:Cascade); requestingTeam Team @relation(fields:[requestingTeamId], references:[id]); requestedBy User @relation(fields:[requestedById], references:[id]); @@unique([opponentPostId,requestingTeamId]) }
model Match { id String @id @default(cuid()); groundId String?; opponentPostId String? @unique; matchDate DateTime; startTime String; endTime String; overs Int; ballType BallType; status MatchStatus @default(SCHEDULED); tossWinnerTeamId String?; tossDecision TossDecision?; winnerTeamId String?; resultText String?; createdAt DateTime @default(now()); updatedAt DateTime @updatedAt; ground Ground? @relation(fields:[groundId], references:[id]); opponentPost OpponentPost? @relation(fields:[opponentPostId], references:[id]); tossWinner Team? @relation("TossWinner", fields:[tossWinnerTeamId], references:[id]); winner Team? @relation("Winner", fields:[winnerTeamId], references:[id]); teams MatchTeam[]; playingXIs PlayingXI[]; innings Innings[]; balls Ball[]; confirmations MatchResultConfirmation[]; ratings TeamRating[]; groundProposals GroundProposal[] }
model GroundSlot { id String @id @default(cuid()); groundId String; date DateTime; startTime String; endTime String; price Decimal @db.Decimal(10,2); status GroundSlotStatus @default(AVAILABLE); sourceUpdatedAt DateTime; createdAt DateTime @default(now()); updatedAt DateTime @updatedAt; ground Ground @relation(fields:[groundId], references:[id], onDelete:Cascade); proposals GroundProposal[]; @@unique([groundId,date,startTime,endTime]); @@index([date,status]) }
model GroundProposal { id String @id @default(cuid()); groundSlotId String; matchId String?; proposedByTeamId String; opponentTeamId String; status GroundProposalStatus @default(PENDING); message String?; createdAt DateTime @default(now()); updatedAt DateTime @updatedAt; groundSlot GroundSlot @relation(fields:[groundSlotId], references:[id]); match Match? @relation(fields:[matchId], references:[id]); proposedByTeam Team @relation("ProposingTeam", fields:[proposedByTeamId], references:[id]); opponentTeam Team @relation("OpponentTeam", fields:[opponentTeamId], references:[id]); @@index([opponentTeamId,status]) }
model MatchTeam { id String @id @default(cuid()); matchId String; teamId String; isHost Boolean @default(false); match Match @relation(fields:[matchId], references:[id], onDelete:Cascade); team Team @relation(fields:[teamId], references:[id]); @@unique([matchId,teamId]) }
model PlayingXI { id String @id @default(cuid()); matchId String; teamId String; userId String; isCaptain Boolean @default(false); isWicketKeeper Boolean @default(false); battingPosition Int?; match Match @relation(fields:[matchId], references:[id], onDelete:Cascade); team Team @relation(fields:[teamId], references:[id]); user User @relation(fields:[userId], references:[id]); @@unique([matchId,userId]) }
model Innings { id String @id @default(cuid()); matchId String; battingTeamId String; inningsNumber Int; status InningsStatus @default(NOT_STARTED); totalRuns Int @default(0); wickets Int @default(0); legalBalls Int @default(0); match Match @relation(fields:[matchId], references:[id], onDelete:Cascade); battingTeam Team @relation(fields:[battingTeamId], references:[id]); overs Over[]; balls Ball[]; battingScores BattingScore[]; bowlingScores BowlingScore[]; @@unique([matchId,inningsNumber]) }
model Over { id String @id @default(cuid()); inningsId String; overNumber Int; bowlerId String; innings Innings @relation(fields:[inningsId], references:[id], onDelete:Cascade); balls Ball[]; @@unique([inningsId,overNumber]) }
model Ball { id String @id @default(cuid()); matchId String; inningsId String; overId String?; sequence Int; overNumber Int; ballNumber Int; batsmanId String; nonStrikerId String; bowlerId String; runsOffBat Int @default(0); extraRuns Int @default(0); extraType ExtraType?; wicketType WicketType?; dismissedPlayerId String?; totalRuns Int; isLegalDelivery Boolean @default(true); createdAt DateTime @default(now()); match Match @relation(fields:[matchId], references:[id], onDelete:Cascade); innings Innings @relation(fields:[inningsId], references:[id], onDelete:Cascade); over Over? @relation(fields:[overId], references:[id]); batsman PlayerProfile @relation("Batsman", fields:[batsmanId], references:[id]); nonStriker PlayerProfile @relation("NonStriker", fields:[nonStrikerId], references:[id]); bowler PlayerProfile @relation("Bowler", fields:[bowlerId], references:[id]); dismissedPlayer PlayerProfile? @relation("DismissedPlayer", fields:[dismissedPlayerId], references:[id]); @@unique([inningsId,sequence]); @@index([matchId,inningsId]) }
model BattingScore { id String @id @default(cuid()); inningsId String; playerId String; runs Int @default(0); ballsFaced Int @default(0); fours Int @default(0); sixes Int @default(0); isOut Boolean @default(false); dismissalText String?; innings Innings @relation(fields:[inningsId], references:[id], onDelete:Cascade); player PlayerProfile @relation(fields:[playerId], references:[id]); @@unique([inningsId,playerId]) }
model BowlingScore { id String @id @default(cuid()); inningsId String; playerId String; ballsBowled Int @default(0); maidens Int @default(0); runsConceded Int @default(0); wickets Int @default(0); wides Int @default(0); noBalls Int @default(0); innings Innings @relation(fields:[inningsId], references:[id], onDelete:Cascade); player PlayerProfile @relation(fields:[playerId], references:[id]); @@unique([inningsId,playerId]) }
model MatchResultConfirmation { id String @id @default(cuid()); matchId String; teamId String; confirmedById String; status ConfirmationStatus @default(PENDING); note String?; createdAt DateTime @default(now()); match Match @relation(fields:[matchId], references:[id], onDelete:Cascade); confirmedBy User @relation(fields:[confirmedById], references:[id]); @@unique([matchId,teamId]) }
model TeamRating { id String @id @default(cuid()); matchId String; ratedTeamId String; ratingTeamId String; score Int; reliabilityScore Int?; comment String?; createdAt DateTime @default(now()); match Match @relation(fields:[matchId], references:[id], onDelete:Cascade); ratedTeam Team @relation("RatedTeam", fields:[ratedTeamId], references:[id]); ratingTeam Team @relation("RatingTeam", fields:[ratingTeamId], references:[id]); @@unique([matchId,ratingTeamId,ratedTeamId]) }
model Notification { id String @id @default(cuid()); userId String; type NotificationType; title String; message String; link String?; readAt DateTime?; createdAt DateTime @default(now()); user User @relation(fields:[userId], references:[id], onDelete:Cascade); @@index([userId,readAt]) }
